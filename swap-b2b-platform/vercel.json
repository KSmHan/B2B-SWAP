{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/index.html", "destination": "/public/index.html" },
    { "source": "/catalog.html", "destination": "/public/catalog.html" },
    { "source": "/account.html", "destination": "/public/account.html" },
    { "source": "/how-it-works.html", "destination": "/public/how-it-works.html" },
    { "source": "/upload.html", "destination": "/public/upload.html" },
    { "source": "/materials.html", "destination": "/public/materials.html" },
    { "source": "/card.html", "destination": "/public/card.html" },
    { "source": "/app.js", "destination": "/public/app.js" },
    { "source": "/styles.css", "destination": "/public/styles.css" },
    { "source": "/media/(.*)", "destination": "/public/media/$1" }
  ],
  "crons": [
    { "path": "/api/cron/keepalive", "schedule": "17 9 * * *" }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 30, "memory": 1024, "includeFiles": "{node_modules/pdf-parse/dist/**,node_modules/@napi-rs/canvas/**,node_modules/@napi-rs/canvas-linux-x64-gnu/**}" }
  }
}
